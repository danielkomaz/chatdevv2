; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PixelForge JRPG"
config/description="A 2D Pixel Art JRPG created with the ChatDevV2 workflow"
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/GameManager.gd"
BattleManager="*res://scripts/battle/BattleManager.gd"
PartyManager="*res://scripts/characters/PartyManager.gd"
DialogueManager="*res://scripts/story/DialogueManager.gd"
QuestManager="*res://scripts/story/QuestManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
SaveManager="*res://scripts/SaveManager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/initial_position_type=1
window/size/initial_position=Vector2i(0, 0)
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

